# random_forest_stop_recommender.py
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import GroupShuffleSplit
from sklearn.metrics import mean_absolute_error
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from joblib import dump

# ----------------------------
# 1) Load data
# ----------------------------
df = pd.read_csv("trip_recommendation_service_dataset.csv")

# Ensure expected columns exist
required_cols = {
    "trip_id", "driver_id", "stop_number", "stop_category",
    "stop_duration_minutes", "kilometers_since_last_stop",
    "time_of_day", "day_of_week", "weather"
}
missing = required_cols - set(df.columns)
if missing:
    raise ValueError(f"Missing required columns: {missing}")

# ----------------------------
# 2) Define categories (targets)
# ----------------------------
categories = sorted(df["stop_category"].unique())

# ----------------------------
# 3) Build per-trip features (X) and per-trip category counts (Y)
#    Each sample = (driver_id, trip_id)
# ----------------------------
def trip_feature_row(group: pd.DataFrame) -> pd.Series:
    feats = {
        "n_stops": len(group),
        "stop_duration_mean": group["stop_duration_minutes"].mean(),
        "stop_duration_std": group["stop_duration_minutes"].std(ddof=0),
        "km_since_last_mean": group["kilometers_since_last_stop"].mean(),
        "km_since_last_std": group["kilometers_since_last_stop"].std(ddof=0),
    }
    # Time-of-day distribution
    tod_share = (
        group["time_of_day"]
        .value_counts(normalize=True)
        .reindex(["Morning", "Afternoon", "Evening", "Night"], fill_value=0.0)
        .to_dict()
    )
    feats.update({f"tod_share_{k}": v for k, v in tod_share.items()})

    # Weekend share
    weekend = {"Sat", "Sun"}
    feats["weekend_share"] = (group["day_of_week"].isin(weekend)).mean()

    # Weather distribution
    wx_share = (
        group["weather"]
        .value_counts(normalize=True)
        .reindex(["Sunny", "Rainy", "Cloudy", "Snowy"], fill_value=0.0)
        .to_dict()
    )
    feats.update({f"wx_share_{k}": v for k, v in wx_share.items()})

    # Pace: km per stop
    feats["km_per_stop"] = group["kilometers_since_last_stop"].sum() / max(len(group), 1)

    # Driver id (for encoding)
    feats["driver_id"] = group["driver_id"].iloc[0]
    return pd.Series(feats)

# Aggregate features per (driver_id, trip_id)
feature_df = (
    df.groupby(["driver_id", "trip_id"], as_index=False)
      .apply(trip_feature_row)
      .reset_index(drop=True)
)

# Targets: counts per category in that trip
count_df = (
    df.groupby(["driver_id", "trip_id", "stop_category"])
      .size()
      .unstack(fill_value=0)
      .reindex(columns=categories, fill_value=0)
      .reset_index()
)

# Merge features and targets
dataset = feature_df.merge(count_df, on=["driver_id", "trip_id"], how="inner")

# ----------------------------
# 4) Train/test split
# ----------------------------
X_cols_numeric = [
    "n_stops", "stop_duration_mean", "stop_duration_std",
    "km_since_last_mean", "km_since_last_std",
    "tod_share_Morning", "tod_share_Afternoon", "tod_share_Evening", "tod_share_Night",
    "weekend_share",
    "wx_share_Sunny", "wx_share_Rainy", "wx_share_Cloudy", "wx_share_Snowy",
    "km_per_stop",
]
X = dataset[X_cols_numeric + ["driver_id"]]
Y = dataset[categories].astype(float)

preprocess = ColumnTransformer(
    transformers=[
        ("num", "passthrough", X_cols_numeric),
        ("driver", OneHotEncoder(handle_unknown="ignore"), ["driver_id"]),
    ],
    remainder="drop",
)

model = RandomForestRegressor(
    n_estimators=500,
    random_state=42,
    n_jobs=-1,
)

pipe = Pipeline(steps=[("prep", preprocess), ("rf", model)])

gss = GroupShuffleSplit(n_splits=1, train_size=0.8, random_state=42)
train_idx, test_idx = next(gss.split(X, Y, groups=dataset["trip_id"]))
X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]
Y_train, Y_test = Y.iloc[train_idx], Y.iloc[test_idx]

# ----------------------------
# 5) Fit
# ----------------------------
pipe.fit(X_train, Y_train)

# Medians for safe fallback
TRAIN_MEDIANS = X_train[X_cols_numeric].median()

# ----------------------------
# 6) Evaluate
# ----------------------------
Y_pred = pipe.predict(X_test)
mae = mean_absolute_error(Y_test.values, Y_pred)
per_cat_mae = dict(zip(categories, np.mean(np.abs(Y_test.values - Y_pred), axis=0)))
print(f"Overall MAE (counts): {mae:.3f}")
print("Per-category MAE:")
for cat, v in per_cat_mae.items():
    print(f"  {cat}: {v:.3f}")

# ----------------------------
# Helper 1: medians from THIS driver's own trips
# ----------------------------
def _driver_history_medians(driver_id: int) -> pd.Series:
    d = df[df["driver_id"] == driver_id]
    if d.empty:
        return pd.Series(dtype=float)
    per_trip = (
        d.groupby(["driver_id", "trip_id"], as_index=False)
         .apply(trip_feature_row)
         .reset_index(drop=True)
    )
    return per_trip[X_cols_numeric].median(numeric_only=True)

# ----------------------------
# Helper 2: driver category prior (counts → prior over seen categories)
# ----------------------------
def _driver_category_prior(driver_id: int) -> np.ndarray:
    """
    Returns a vector (aligned with `categories`) with prior probabilities
    proportional to how often this driver used each category in the past.
    Categories never seen by the driver get 0 prior (masked out).
    """
    d = df[df["driver_id"] == driver_id]
    counts = d["stop_category"].value_counts()
    prior = np.array([counts.get(cat, 0) for cat in categories], dtype=float)
    if prior.sum() > 0:
        prior = prior / prior.sum()
    return prior  # zeros for unseen categories

# ----------------------------
# Helper 3: largest remainder allocation
# ----------------------------
def _largest_remainder_allocation(scores: np.ndarray, total: int) -> np.ndarray:
    scores = np.maximum(scores, 0.0).astype(float)
    if total <= 0:
        return np.zeros_like(scores, dtype=int)
    s = scores.sum()
    if s <= 0:
        base = np.zeros_like(scores, dtype=int)
        for i in range(total):
            base[i % len(scores)] += 1
        return base
    raw = scores * (float(total) / s)
    base = np.floor(raw).astype(int)
    remainder = int(total - base.sum())
    if remainder > 0:
        frac = raw - base
        for idx in np.argsort(-frac)[:remainder]:
            base[idx] += 1
    return base

# ----------------------------
# 7) Inference helper (AUTO + sensitivity controls)
# ----------------------------
def recommend_stops(
    driver_id: int,
    *,
    n_stops: int = None,              # if None → infer from driver history
    stop_duration_mean: float = None,
    stop_duration_std: float = None,
    km_since_last_mean: float = None,
    km_since_last_std: float = None,
    tod_shares: dict = None,
    weekend_share: float = None,
    wx_shares: dict = None,
    km_per_stop: float = None,
    # Sensitivity / blending knobs:
    tau: float = 0.7,                 # <1 sharpens model differences, >1 flattens
    gamma: float = 1.3,               # prior strength; >1 emphasizes popular driver categories
    explore: float = 0.50,            # fraction of mass from the (powered) prior
    clip_nonneg: bool = True,
):
    """
    Predict integer counts per category for a driver.

    - Auto-fills missing features from THIS driver's history; falls back to TRAIN_MEDIANS if needed.
    - Uses the model's raw predictions, but:
        * Masks out categories the driver has NEVER used (0 probability).
        * Blends with a driver-history PRIOR so popular categories get more mass,
          while still leaving room ("explore") for less-popular-but-seen categories.
        * Allocates exactly `n_stops` via largest remainder.
    - Tunables:
        tau   -> temperature on model scores (lower = sharper)
        gamma -> exponent on prior (higher = more weight on popular categories)
        explore -> how much to mix the prior into the final probabilities
    """
    # Driver medians for features
    dmed = _driver_history_medians(driver_id)
    has_history = not dmed.empty
    med = dmed.reindex(TRAIN_MEDIANS.index, fill_value=np.nan) if has_history else TRAIN_MEDIANS.copy()
    med = med.fillna(TRAIN_MEDIANS)

    def pick(value, key):
        return value if value is not None else float(med[key])

    # Shares auto-fill from history (or training medians)
    if tod_shares is None:
        tod_shares = {
            "Morning": float(med["tod_share_Morning"]),
            "Afternoon": float(med["tod_share_Afternoon"]),
            "Evening": float(med["tod_share_Evening"]),
            "Night": float(med["tod_share_Night"]),
        }
    if wx_shares is None:
        wx_shares = {
            "Sunny": float(med["wx_share_Sunny"]),
            "Rainy": float(med["wx_share_Rainy"]),
            "Cloudy": float(med["wx_share_Cloudy"]),
            "Snowy": float(med["wx_share_Snowy"]),
        }
    if weekend_share is None:
        weekend_share = float(med["weekend_share"])

    # Infer n_stops from history if not provided
    inferred_n = int(round(pick(n_stops, "n_stops")))
    if inferred_n < 1:
        inferred_n = 1

    # Build the feature row for the model
    row = {
        "n_stops": inferred_n,
        "stop_duration_mean": pick(stop_duration_mean, "stop_duration_mean"),
        "stop_duration_std": pick(stop_duration_std, "stop_duration_std"),
        "km_since_last_mean": pick(km_since_last_mean, "km_since_last_mean"),
        "km_since_last_std": pick(km_since_last_std, "km_since_last_std"),
        "tod_share_Morning": tod_shares.get("Morning", float(med["tod_share_Morning"])),
        "tod_share_Afternoon": tod_shares.get("Afternoon", float(med["tod_share_Afternoon"])),
        "tod_share_Evening": tod_shares.get("Evening", float(med["tod_share_Evening"])),
        "tod_share_Night": tod_shares.get("Night", float(med["tod_share_Night"])),
        "weekend_share": weekend_share,
        "wx_share_Sunny": wx_shares.get("Sunny", float(med["wx_share_Sunny"])),
        "wx_share_Rainy": wx_shares.get("Rainy", float(med["wx_share_Rainy"])),
        "wx_share_Cloudy": wx_shares.get("Cloudy", float(med["wx_share_Cloudy"])),
        "wx_share_Snowy": wx_shares.get("Snowy", float(med["wx_share_Snowy"])),
        "km_per_stop": pick(km_per_stop, "km_per_stop"),
        "driver_id": driver_id,
    }
    x_row = pd.DataFrame([row])

    # Model scores
    raw = pipe.predict(x_row)[0]
    if clip_nonneg:
        raw = np.maximum(raw, 0.0)

    # Driver prior (zeros for unseen categories)
    prior = _driver_category_prior(driver_id)

    # Mask: only categories seen by the driver are allowed
    mask = (prior > 0).astype(float)
    if mask.sum() == 0:
        # No history for this driver → use model across all categories (no mask)
        mask = np.ones_like(raw)

    # Temperature-softmax on model scores (after masking)
    raw_masked = raw * mask
    if raw_masked.sum() > 0:
        z = raw_masked / max(tau, 1e-6)  # sharpen differences
        z = z - z.max()                  # numerical stability
        p_model = np.exp(z)
        if p_model.sum() > 0:
            p_model = p_model / p_model.sum()
        else:
            p_model = mask / mask.sum()
    else:
        p_model = mask / mask.sum()

    # Powered prior (emphasize popular categories)
    if prior.sum() > 0:
        p_prior = prior ** max(gamma, 1e-6)
        if p_prior.sum() > 0:
            p_prior = p_prior / p_prior.sum()
        else:
            p_prior = mask / mask.sum()
    else:
        p_prior = mask / mask.sum()

    # Blend: mostly model, with some prior to boost popular & include less-popular
    explore = min(max(explore, 0.0), 1.0)
    p = (1 - explore) * p_model + explore * p_prior

    # Re-apply mask & renormalize
    p = p * mask
    if p.sum() == 0:
        p = mask / mask.sum()
    else:
        p = p / p.sum()

    # Allocate exactly n_stops
    counts = _largest_remainder_allocation(p, inferred_n)

    # Optional debug:
    # print("DEBUG p_model:", dict(zip(categories, np.round(p_model, 3))))
    # print("DEBUG p_prior:", dict(zip(categories, np.round(p_prior, 3))))
    # print("DEBUG final p:", dict(zip(categories, np.round(p, 3))))

    return dict(sorted(zip(categories, counts), key=lambda kv: kv[1], reverse=True))

# ----------------------------
# 8) Example usage
# ----------------------------
print("\nRecommended counts per category (auto; sensitive):")
example_auto = recommend_stops(
    driver_id=5,
    # You can tweak these to be more/less sensitive:
    tau=0.7,      # lower -> sharper preference for top categories
    gamma=1.4,    # higher -> more weight on driver's popular categories
    explore=0.7  # more -> include more of the less-popular-but-seen ones
)
for cat, c in example_auto.items():
    print(f"{cat}: {c}")

# ----------------------------
# 9) Persist model (optional)
# ----------------------------
dump(pipe, "rf_stop_recommender.joblib")
